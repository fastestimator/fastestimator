FROM ubuntu:22.04 as base
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG C.UTF-8

# Install system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    gnupg \
    ca-certificates \
    wget \
    curl \
    unzip \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Add deadsnakes PPA for Python 3.10
RUN add-apt-repository ppa:deadsnakes/ppa

# Install Python 3.10
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-venv \
    python3.10-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.10 as default
RUN ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.10 /usr/bin/python

# Install UV
ENV UV_INSTALL_DIR="/usr/local"
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/usr/local/bin:$PATH"

# OpenCV dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Traceability requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    graphviz \
    texlive-latex-base \
    texlive-latex-extra \
    && rm -rf /var/lib/apt/lists/*

# GPU cleaning requirement
RUN apt-get update && apt-get install -y --no-install-recommends lsof && rm -rf /var/lib/apt/lists/*

# Create virtual environment with UV
RUN uv venv /opt/venv --python 3.10
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install PyTorch (CPU) using UV
RUN uv pip install torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 --index-url https://download.pytorch.org/whl/cpu

# Install Jupyter and testing packages
RUN uv pip install \
    ipython==8.18.1 \
    ipykernel==6.27.1 \
    ipywidgets==8.1.1 \
    papermill==2.4.0 \
    traitlets==5.14.0 \
    jupyter-client \
    notebook

RUN ipython kernel install --user --name nightly_build

# Install FastEstimator
ARG InstallFE=True
RUN if [ "$InstallFE" = "True" ]; then uv pip install fastestimator; fi

COPY bashrc /etc/bash.bashrc
RUN chmod a+rwx /etc/bash.bashrc

WORKDIR /
